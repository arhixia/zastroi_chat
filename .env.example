# Скопируйте этот файл в .env (cp .env.example .env) и заполните значения.
# Комментарии пишите только на отдельных строках, не в конце строки со значением.

# Режим отладки FastAPI (на тестовом сервере оставить false)
DEBUG=false
# Логировать каждый SQL-запрос
SQL_ECHO=false

# PostgreSQL
# DB_HOST не менять: это имя сервиса в docker-сети
DB_HOST=postgres
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASS=change_me

# Redis
# REDIS_HOST не менять: это имя сервиса в docker-сети
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# OpenRouter
# вписать свой ключ
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Модель для генерации ответов
LLM_MODEL=openai/gpt-5.6-terra
# Модель для эмбеддингов и размерность её вектора
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536

# Авторизация админки
#  вписать длинную случайную строку
JWT_SECRET=
JWT_ALGORITHM=HS256
# Сколько минут живёт токен
JWT_EXPIRE_MINUTES=120

# Публичные адреса, которые открывает браузер.
# В продакшене их нужно менять на реальные.
WIDGET_SCRIPT_URL=http://localhost:8000/widget.js
API_HOST=http://localhost:8000
